   xmp:CreatorTool="Adobe Photoshop CC 2015 (Windows)">
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:70d1b95d-3ca5-be4a-a414-5f5faaa3889a"
      stEvt:when="2017-06-15T10:26:02+04:30"
      stEvt:softwareAgent="Adobe Photoshop CC 2015 (Windows)"
      stEvt:changed="/"/>
     <rdf:li
      stEvt:action="converted"
      stEvt:parameters="from image/jpeg to image/tiff"/>
