<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>Metabolomics-based discovery of XHP as a CYP3A4 inhibitor against pancreatic cancer</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>Yuting Yang</rdf:li>
