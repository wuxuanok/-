        </rdf:Alt>
      </dc:description>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Effects of Bai zhu san (Atractylodis macrocephalae) decoction on cellular immunity and Th1/Th2 cytokine ratio in a Mifepristone-induced murine abortion model</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Bai zhu san</rdf:li>
          <rdf:li>mifepristone</rdf:li>
          <rdf:li>cytokine</rdf:li>
          <rdf:li>anti-abortive</rdf:li>
          <rdf:li>CD4+, CD8+T cells</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:creator>
        <rdf:Seq>
